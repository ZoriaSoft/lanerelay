{
  "name": "lanerelay",
  "version": "0.9.0",
  "description": "Relay one coding task across several AI agent CLIs (Claude Code, Codex, Gemini, opencode, …): when one lane hits its usage limit, the task and a handoff note move to the next.",
  "keywords": [
    "ai",
    "agent",
    "cli",
    "claude-code",
    "codex",
    "gemini",
    "opencode",
    "rate-limit",
    "quota",
    "fallback",
    "handoff"
  ],
  "homepage": "https://github.com/ZoriaSoft/quota-pilot#readme",
  "bugs": {
    "url": "https://github.com/ZoriaSoft/quota-pilot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZoriaSoft/quota-pilot.git"
  },
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "lanerelay": "dist/cli.js",
    "lr": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "compile": "sh scripts/compile.sh all",
    "prepack": "npm run build",
    "smoke": "sh test/smoke.sh"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
