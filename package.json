{
  "name": "quota-pilot",
  "version": "0.7.0",
  "description": "Run one coding task across several AI agent CLIs; when one lane hits its quota, the task hops to the next.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "qp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "compile": "sh scripts/compile.sh all"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
